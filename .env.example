# PayPal configuration
# Get these from https://developer.paypal.com/dashboard/applications/live (or sandbox)
PAYPAL_ENV=live
PAYPAL_CLIENT_ID=your_paypal_client_id_here
PAYPAL_CLIENT_SECRET=your_paypal_client_secret_here

# Optional: override the PayPal API base URL (defaults are correct for sandbox/live).
# PAYPAL_API_BASE=https://api-m.paypal.com

# Public client id (exposed to the browser via the JS SDK).
# Must match PAYPAL_CLIENT_ID for the same environment.
NEXT_PUBLIC_PAYPAL_CLIENT_ID=your_paypal_client_id_here

# Optional: override the tax rate (default is 0.08875 = 8.875% NYC)
# NEXT_PUBLIC_TAX_RATE=0.0825
